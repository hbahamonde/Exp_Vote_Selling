\subsection{Definition and geographical relevance}

\miniframeson
\begin{frame}[c]{}

{\bf Clientelism}: distribution of private rewards to individuals during political elections in exchange for electoral support {\scriptsize{\color{gray}(Nichter, 2014)}}.

\vspace{0.5cm}

\uncover<2->{\large {\color{blue}E.g., cash for your vote}.}

\vspace{0.8cm}

\centering
\includegraphics[scale=0.3]{/Users/hectorbahamonde/research/Economic_Experiment_Vote_Selling/Resources_Presentation/vote_buying.jpg}

\end{frame}


