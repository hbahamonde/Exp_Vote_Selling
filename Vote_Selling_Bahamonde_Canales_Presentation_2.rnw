\iffalse
\miniframesoff
\begin{frame}[c]{Why Electorally Strong but Distant Parties Pay More}
\begin{columns}[T,totalwidth=\textwidth]

% LEFT
\begin{column}{0.55\textwidth}
\begin{itemize}[<+->]
  \item A distant party must compensate the voter of switching sides.\\
  {\scriptsize\color{gray}
  The switching cost is \(\Delta\).}

\item But if that distant party is electorally strong, losing the negotiated voter becomes costly, so loss aversion raises its acceptable price ceiling.\\
{\scriptsize\color{gray}
\(\overline{R}_i=\min\{B_i,[1+(\lambda_i-1)\ell_i]R_i\}\)}
\end{itemize}

\medskip
\onslide<3->{
\begin{block}{Core idea}
{\scriptsize Voters ask more from ideologically distant parties but electorally willing to pay.}
\end{block}
}
\end{column}

