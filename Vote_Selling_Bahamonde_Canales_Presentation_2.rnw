\miniframeson
\subsection{Gaps in the literature}

\begin{frame}[c]{Sequencing and Clientelism: Supply and Demand}
\begin{itemize}
  

  \item {\bf Qualitative}: how \textbf{voters begin} the sequence, and {\bf sell their votes} ({\color{blue}vote selling}).

  \item {\bf Quantitative}: how \textbf{parties begin} the sequence, and {\bf buy votes} ({\color{blue}vote buying}).\pause

 \bigskip

  \item[\checkmark] {\color{blue} {\bf We argue}: clientelism is a {\bf market}, with both \emph{buyers} {\bf and} \emph{sellers}}.

  \item[\checkmark] {\color{blue} {\bf The gap}: the literature has failed to consider the political economy of both vote-buyers \emph{and} vote-sellers}.
 \end{itemize}
\end{frame}


\miniframesoff
\begin{frame}[c]{Sequencing and Clientelism: Supply and Demand}
\centering
\includegraphics[width=0.75\textwidth]{/Users/hectorbahamonde/research/Exp_Vote_Selling/histogram_meta_plot_wide.pdf}
\vspace{0.2cm}

{\tiny Annual frequency of Web of Science publications whose abstracts include the terms ``vote buying'' and ``vote selling.''}
\end{frame}



\subsection{Our contribution}

\miniframeson
\begin{frame}[c]{Our Paper and Today's Talk}
\begin{itemize}
  \item {\bf Exactly what we tackle}: integrate {\color{red}vote buying} \emph{and} {\color{blue}vote selling} into the same framework.\pause
  \item {\bf Theory}: formalize a {\bf spatial model} with one voter and two parties.

    \begin{enumerate}
            \item {\color{red}Parties move first}.
            \item {\color{blue}Voters move first}.

    \end{enumerate}\pause


  
  \item {\bf Experiment}: we designed a lab experiment based on the spatial model.\pause

  
  \item {\bf Findings}:
  \begin{itemize}
    \item[\checkmark] {\color{red}When parties move first}: transfers concentrate on \textbf{party supporters}.
    \item[\checkmark] {\color{blue}When voters move first}: they \textbf{demand higher prices} from winning parties that are ideologically far away.
    \item[\checkmark] Voters \textbf{make more} when parties begin the exchange.
  \end{itemize}
\end{itemize}
\end{frame}

%====================
% THEORY
%====================

\section{Formal Theory}

\subsection{Formalization}


% ------------------------------------------------------------
% Theory section: Prospect-theoretic spatial model
% Simplified version: two bullets per slide
% ------------------------------------------------------------

\iffalse
\miniframeson
\begin{frame}[c]{A Prospect-Theoretic Model of Vote Buying and Vote Selling}\begin{columns}[T,totalwidth=\textwidth]

% LEFT
\begin{column}{0.55\textwidth}
\begin{itemize}[<+->]
  \item Voters and parties live on a simple \textbf{left--right space}, so voters prefer the party located closer to their own ideal point.\\
  {\scriptsize\color{gray}
  Parties \(L,R\) at \(\gamma_L,\gamma_R\); voter \(j\) at \(x_j\).}

  \item The voter's preferred party has an ideological advantage, and that advantage is the compensation the voter must receive to switch sides.\\
  {\scriptsize\color{gray}
  \(\Delta=u_j(\gamma_{i^\ast})-u_j(\gamma_{-i^\ast})>0\)}
\end{itemize}

\medskip
\onslide<3->{
\begin{block}{Core idea}
{\scriptsize \(\Delta\) is the ideological price of switching sides.}
\end{block}
}
\end{column}

% RIGHT
\begin{column}{0.45\textwidth}
\centering
\begin{tikzpicture}[scale=0.9,baseline=(axis.base)]
  \path[use as bounding box] (-0.4,-1.1) rectangle (5.4,3.2);
  \coordinate (axis) at (2.5,0);

  % axis
  \draw[<->] (0,0) -- (5,0);
  \node[below] at (0,0) {\scriptsize Left};
  \node[below] at (5,0) {\scriptsize Right};

  % parties
  \onslide<1->{
    \node[circle,draw,fill=blue!20] at (1,0) {\scriptsize \(L\)};
    \node[circle,draw,fill=red!20]  at (4,0) {\scriptsize \(R\)};
  }

  % voter
  \onslide<1->{
    \node[circle,draw,fill=gray!20] at (2.2,0) {\scriptsize \(j\)};
  }

  % distances
  \onslide<2->{
    \draw[<->,thick] (1,0.45) -- (2.2,0.45);
    \node at (1.6,0.75) {\scriptsize closer};

    \draw[<->,thick] (2.2,-0.45) -- (4,-0.45);
    \node at (3.1,-0.75) {\scriptsize farther};
  }

  % Delta
  \onslide<3->{
  \draw[decorate,decoration={brace,amplitude=4pt},thick]
    (1.55,1.15) -- (3.45,1.15);
  \node[align=center] at (2.5,1.85)
    {\scriptsize cost of switching\\[-1mm]
     \scriptsize \(\Delta\)};
}
\end{tikzpicture}
\end{column}

\end{columns}
\end{frame}
\fi


\miniframeson
\begin{frame}[c]{A Prospect-Theoretic Spatial Theory of Vote Buying}
\begin{columns}[T,totalwidth=\textwidth]

% LEFT
\begin{column}{0.55\textwidth}
\begin{itemize}[<+->]
  \item In our design, parties value buying votes because it might reduce electoral loss.\\
  {\scriptsize\color{gray}
  \(R_i=q(v_i,P_d)W_i\)}

  \item Parties are {\bf loss averse}: the threat of defeat {\bf inflates} how much they are willing to pay for electoral insurance.\\
  {\scriptsize\color{gray}
  \(\widetilde{R}_i=[1+(\lambda_i-1)\ell_i]R_i\)}
\end{itemize}

\medskip
\onslide<3->{
\begin{block}{Core idea}
{\scriptsize
Loss aversion makes electoral stakes, \(R_i\), look larger (\(\widetilde{R}_i\)).
}
\end{block}
}
\end{column}

% RIGHT
\begin{column}{0.45\textwidth}
\centering
\begin{tikzpicture}[scale=0.9,baseline=(base.base)]
  \path[use as bounding box] (-0.2,-0.7) rectangle (5.2,3.5);
  \coordinate (base) at (2.5,0);

  % baseline expected value
  \onslide<1->{
    \draw[thick] (0.8,0) -- (0.8,1.2);
    \draw[fill=gray!20] (0.5,0) rectangle (1.1,1.2);
    \node[below] at (0.8,0) {\scriptsize \(R_i\)};
    \node[above,align=center] at (0.8,1.2) {\scriptsize expected\\[-1mm]\scriptsize stake};
  }

  % loss aversion expansion
  \onslide<2->{
    \draw[fill=orange!25] (2.2,0) rectangle (2.8,1.9);
    \node[below] at (2.5,0) {\scriptsize \(\widetilde{R}_i\)};
    \node[above,align=center] at (2.5,1.9)
      {\scriptsize loss-averse\\[-1mm]\scriptsize stake};
    \draw[->,thick] (1.2,1.2) -- (2.1,1.9);
  }

  % budget cap
  \onslide<3->{
    \draw[dashed,thick] (3.4,1.55) -- (5.0,1.55);
    \node[right] at (5.0,1.55) {\scriptsize budget \(B_i\)};
    \draw[fill=green!20] (3.8,0) rectangle (4.4,1.55);
    \node[below] at (4.1,0) {\scriptsize \(\overline{R}_i\)};
    \node[above,align=center] at (4.1,1.55)
      {\scriptsize feasible\\[-1mm]\scriptsize ceiling};
  }
\end{tikzpicture}
\end{column}

\end{columns}
\end{frame}


\iffalse
\miniframesoff
\begin{frame}[c]{Vote Buying: Parties Move First}
\begin{columns}[T,totalwidth=\textwidth]

% LEFT
\begin{column}{0.55\textwidth}
\begin{itemize}[<+->]
\item When parties move first, offers target voters whose support helps reduce electoral losses.\\
{\scriptsize\color{gray}
Parties exaggerate their payments to prevent ``catastrophic'' losses \(\widetilde{R}_i\).}

\item Because ideological distance raises the cost of vote buying, parties have stronger incentives to buy from proximate voters.\\
{\scriptsize\color{gray}
Successful buying requires \(c_i(s_{-i})\leq\overline{R}_i\).}
\end{itemize}

\medskip
\onslide<3->{
\begin{block}{Core idea}
{\scriptsize {\bf Parties prefer buying from their own supporters} because their ideological switching cost is lower.}
\end{block}
}
\end{column}

% RIGHT
\begin{column}{0.45\textwidth}
\centering
\begin{tikzpicture}[scale=0.9,baseline=(axis.base)]
  \path[use as bounding box] (-0.4,-1.1) rectangle (5.4,3.2);
  \coordinate (axis) at (2.5,0);

  % axis
  \draw[<->] (0,0) -- (5,0);
  \node[below] at (0,0) {\scriptsize Left};
  \node[below] at (5,0) {\scriptsize Right};

  % parties and voter
  \node[circle,draw,fill=blue!20] at (1,0) {\scriptsize \(L\)};
  \node[circle,draw,fill=red!20]  at (4,0) {\scriptsize \(R\)};
  \node[circle,draw,fill=gray!20] at (2.2,0) {\scriptsize \(j\)};

  % L offer
  \onslide<1->{
    \draw[->,thick,blue!70!black] (1,1.25) -- (2.0,0.25);
    \node[above,align=center] at (1,1.25)
      {\scriptsize low cost\\[-1mm]\scriptsize \(c_L\)};
  }

  % R offer
  \onslide<2->{
    \draw[->,thick,red!70!black] (4,1.25) -- (2.4,0.25);
    \node[above,align=center] at (4.1,1.25)
      {\scriptsize higher cost\\[-1mm]\scriptsize \(c_R=c_L+\Delta\)};
  }

  % condition
  \onslide<3->{
    \node[draw,rounded corners,fill=white,align=center] at (2.5,-1.5)
      {\scriptsize party buys only if\\[-1mm]
       \scriptsize \(c_i(s_{-i})\leq \overline{R}_i\)};
  }
\end{tikzpicture}
\end{column}

\end{columns}
\end{frame}
