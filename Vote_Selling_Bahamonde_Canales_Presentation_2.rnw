%====================
\section{Introduction}
%====================

\subsection{Motivation}

\miniframeson
\begin{frame}[c]{Clientelism Is a Market}
\begin{columns}[c,totalwidth=\textwidth]
\begin{column}{0.55\textwidth}
\begin{itemize}
  \item {\bf Clientelism}: private rewards in exchange for electoral support {\scriptsize{\color{gray}(Nichter, 2014)}}.\pause
  \medskip
  \item Formal models: {\color{red}parties set the price} of a vote; voters accept or not.\pause
  \medskip
  \item Fieldwork: {\color{blue}voters often set the price}---they ask, request, and bargain.\pause
  \medskip
  \item[\checkmark] {\bf Our question}: {\color{blue}what changes when the voter, not the party, names the price?}
\end{itemize}
\end{column}
\begin{column}{0.45\textwidth}
\centering
\includegraphics[width=\textwidth]{/Users/hectorbahamonde/research/Economic_Experiment_Vote_Selling/Resources_Presentation/vote_buying.jpg}
\end{column}
\end{columns}
\end{frame}

\miniframesoff
\begin{frame}[c]{Vote Selling Is Under-Studied}
\centering
\includegraphics[width=0.75\textwidth]{/Users/hectorbahamonde/research/Exp_Vote_Selling/histogram_meta_plot_wide.pdf}
\vspace{0.2cm}

{\tiny Annual frequency of Web of Science publications whose abstracts include the terms ``vote buying'' and ``vote selling.''}
\end{frame}

\subsection{This paper}

\miniframeson
\begin{frame}[c]{This Paper in One Slide}
\begin{itemize}
  \item {\bf Theory}: one voter, two parties, same budget. Two price-setting {\it institutions} for the {\it same} exchange:
  \begin{enumerate}
    \item {\color{red}Price-setting parties} (vote buying).
    \item {\color{blue}Price-setting voter} (vote selling).
  \end{enumerate}\pause
  \item {\bf Prediction}: giving the voter price-setting power should transfer a large rent to the voter.\pause
  \item {\bf Lab experiment} in Chile: \Sexpr{nAll} participants, \Sexpr{sAll} sessions.\pause
  \item {\bf Finding}: {\color{blue}the predicted rent does not materialize}.
  \begin{itemize}
    \item[\checkmark] Parties {\bf pay for votes that cannot change the outcome}.
    \item[\checkmark] Voters who set prices {\bf ask for about half} of what parties would pay.
  \end{itemize}
\end{itemize}
\end{frame}

%====================
\section{Theory}
%====================

\subsection{Intuition}

\miniframeson
\begin{frame}[c]{The Model as a Motivation: Three Ideas}
\begin{enumerate}
  \item {\bf A vote is worth the election---but only if it is pivotal.}\\
  {\small Pivotal: worth the full value of office to {\it either} party. Non-pivotal: worth {\color{red}nothing}.}\pause
  \medskip
  \item {\bf When parties set prices}, they compete for the voter.\\
  {\small The preferred party wins and pays less the more the voter likes it (``core voter'' logic).}\pause
  \medskip
  \item {\bf When the voter sets prices}, it is an ultimatum game.\\
  {\small The voter can play one party against the other and ask for the {\color{blue}whole budget}.}
\end{enumerate}
\pause
\medskip
\begin{exampleblock}{{\small Proposer advantage}}
{\small Moving price-setting power to a pivotal voter should raise the voter's earnings by $\min(\Delta, M)$: ideological attachment, capped by the budget. Loss aversion should not matter when budgets bind.}
\end{exampleblock}
\end{frame}

%====================
\section{Experiment}
%====================

\subsection{Design}

\miniframeson
\begin{frame}[c]{Two Games, Assigned by Session}
\centering
\includegraphics[width=\textwidth]{/Users/hectorbahamonde/research/Exp_Vote_Selling/experimental_flow_3.pdf}

\vspace{0.2cm}
{\scriptsize Groups of three, three paid rounds, roles reshuffled each round; random budgets (900--1,800), induced ideological payoffs, and a fictional electorate that makes the voter pivotal or not.}
\end{frame}

%====================
\section{Results}
%====================

\subsection{Behavior}

\miniframeson
\begin{frame}[c]{Result 1: Pivotality Matters, but Not Enough}
\begin{columns}[c,totalwidth=\textwidth]
\begin{column}{0.58\textwidth}
\centering
\includegraphics[width=\textwidth]{/Users/hectorbahamonde/research/Exp_Vote_Selling/benchmark_behaviour.pdf}
\end{column}
\begin{column}{0.42\textwidth}
\begin{itemize}
  \item[\checkmark] Direction is right: offers and acceptances {\bf rise with pivotality}.\pause
  \medskip
  \item[$\times$] But {\color{red}\Sexpr{f0(rt$vb.np.any$est)}\%} of parties pay for {\bf non-pivotal} votes (benchmark: 0\%).\pause
  \medskip
  \item[$\times$] Parties accept {\color{red}\Sexpr{f0(acc0)}\%} of non-pivotal requests.
\end{itemize}
\end{column}
\end{columns}
\end{frame}

\begin{frame}[c]{Result 2: Voters Under-Use Their Power}
\begin{itemize}
  \item Benchmark: a pivotal price-setting voter asks for {\bf 100\%} of the budget.\pause
  \medskip
  \item Observed: pivotal voters ask for {\color{blue}\Sexpr{f0(rt$vs.p.req$est)}\%} of the budget; only \Sexpr{f0(rt$vs.p.full$est)}\% ask for all of it.\pause
  \medskip
  \item And parties reject {\color{red}\Sexpr{f0(100 - acc1)}\%} of pivotal requests they should accept.\pause
  \medskip
  \item[\checkmark] Voters behave like {\bf cautious ultimatum proposers}: transfer of \Sexpr{f0(pv(VS,1,"transfer"))} points vs.\ a benchmark of \Sexpr{f0(pv(VS,1,"bench.transfer"))}.
\end{itemize}
\end{frame}

\subsection{Payoffs}

\miniframeson
\begin{frame}[c]{Result 3: The Proposer Advantage Disappears}
\begin{columns}[c,totalwidth=\textwidth]
\begin{column}{0.58\textwidth}
\centering
\includegraphics[width=\textwidth]{/Users/hectorbahamonde/research/Exp_Vote_Selling/benchmark_payoffs.pdf}
\end{column}
\begin{column}{0.42\textwidth}
\begin{itemize}
  \item Predicted gain for pivotal voters: {\bf \Sexpr{f0(Gr$bench)}} points.\pause
  \medskip
  \item Observed: {\color{blue}\Sexpr{f0(Gr$est)}} points {\scriptsize [\Sexpr{f0(Gr$lo)}, \Sexpr{f0(Gr$hi)}]}.\pause
  \medskip
  \item Not a power problem: MDE = \Sexpr{f0(Gr$mde)}; equivalence bound $\pm$\Sexpr{f0(Gr$tost)}.
\end{itemize}
\end{column}
\end{columns}
\end{frame}

\begin{frame}[c]{Why? Two Deviations That Offset Each Other}
\begin{itemize}
  \item {\color{red}Price-setting parties}: overpaying for non-pivotal votes {\bf raises} voter earnings.\pause
  \medskip
  \item {\color{blue}Price-setting voter}: under-asking {\bf lowers} voter earnings.\pause
  \medskip
  \item Is overpayment loss-averse ``insurance''? {\bf No}: leading and trailing parties pay the same.\pause
  \medskip
  \item[\checkmark] Better described as {\bf imperfect conditioning on pivotality}, not prospect theory.
\end{itemize}
\end{frame}

%====================
\section{Discussion}
%====================

\subsection{Takeaways}

\miniframeson
\begin{frame}[c]{Takeaways}
\begin{itemize}
  \item {\bf Theory}: who sets the price {\it should} decide who gets the clientelist rent.\pause
  \medskip
  \item {\bf Evidence}: in the lab, it does not---the rent leaks to voters in similar amounts under both institutions.\pause
  \medskip
  \item {\bf Public choice}: the incidence of political rents may depend less on who initiates the exchange and more on how well actors judge {\color{blue}when a vote is decisive}.\pause
  \medskip
  \item {\bf Policy}: targeting buyers alone misses voter-initiated exchange, but voter initiative does not by itself shift rents toward voters.
\end{itemize}
\end{frame}

