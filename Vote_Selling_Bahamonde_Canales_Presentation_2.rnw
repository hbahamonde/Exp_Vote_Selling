<<revision.tests, echo=FALSE, comment=NA, warning=FALSE, message=FALSE, include=FALSE, cache=FALSE, eval=TRUE>>=
@

<<nums, echo=FALSE, include=FALSE, cache=FALSE>>=
VB <- "Vote Buying"; VS <- "Vote Selling"
P   <- as.data.frame(rt$payoffs)
pv  <- function(g, piv, col) P[P$game == g & P$pivotal == piv, col]
nAll <- rt$participants[[VB]] + rt$participants[[VS]]
sAll <- rt$sessions[[VB]] + rt$sessions[[VS]]
acc  <- as.data.frame(rt$vs.acc)
acc0 <- acc$accept[acc$pivotal == 0]; acc1 <- acc$accept[acc$pivotal == 1]
Gr   <- rt$gap$piv.rule
@

