\subsection{Hypotheses}

\miniframeson
\begin{frame}[c]{Formally Derived Hypotheses}
\begin{itemize}[<+->]

  \item[] \textbf{[H1] Core Targeting Under Party Initiative}
  \begin{itemize}
    \item When parties initiate vote buying, they mainly buy from ideologically proximate voters because those voters are cheaper to secure.\\
    {\scriptsize\color{gray}
    Successful buying requires \(c_i(s_{-i})\leq\overline{R}_i\), and \(c_i\) rises with ideological distance.}
  \end{itemize}

  \medskip

  \item[] \textbf{[H2] Selling to the Opponent Winning Party}
  \begin{itemize}
 \item When voters initiate vote selling, they demand higher prices from electorally strong and ideologically distant parties.\\
{\scriptsize\color{gray}
High demands are possible when \(\overline{R}_{-i^\ast}\) is large enough to compensate the switching cost \(\Delta\).}
  \end{itemize}

  \medskip

  \item[] \textbf{[H3] Higher Voter Payoffs Under Party Initiative}
  \begin{itemize}
    \item When parties initiate vote buying, voters can earn more because loss-averse parties may pay an insurance premium above the minimum switching price.\\
    {\scriptsize\color{gray}
    \(s_i=c_i(s_{-i})+\rho_i\), with \(\rho_i\) increasing in \(\lambda_i\), \(\ell_i\), and \(R_i\).}
  \end{itemize}

\end{itemize}
\end{frame}





%====================
% EXPERIMENT
%====================

\section{Experimental Design}

\subsection{Setup and roles}


\miniframeson
\begin{frame}[c]{Laboratory Implementation}
\begin{itemize}
  \item \textbf{Participants and implementation}
  \begin{itemize}
    \item Following the formal model, we designed a lab experiment in \texttt{oTree}.
    \item Recruited 102 adult participants.
    \item Payed them according to the quality of their decisions.
  \end{itemize}\pause
  
  \item \textbf{Roles}
  \begin{itemize}
    \item Each game: three (real) players (Party {\bf A}, Party {\bf B}, Voter).
    \item Each participant played the game {\color{blue}three times} (n=306).
    \item Every time we executed a new randomization block. 
  \end{itemize}\pause

  \item \textbf{What was randomized {\color{blue}(3x)}}
  \begin{itemize}
    \item Role (party, voter).
    \item Voter's ideology (payoffs if {\bf A} or {\bf B} wins).
    \item Party budgets (to buy votes).
    \item Vote shares.
  \end{itemize}
\end{itemize}
\end{frame}


