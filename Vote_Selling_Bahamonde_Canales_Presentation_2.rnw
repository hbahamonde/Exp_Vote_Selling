\iffalse
\miniframesoff
\begin{frame}[c]{Party Initiative Creates an Insurance Premium}
\begin{columns}[T,totalwidth=\textwidth]

% LEFT
\begin{column}{0.55\textwidth}
\begin{itemize}[<+->]
  \item Minimum offers make voters indifferent, but loss-averse parties {\bf pay more} to reduce electoral losses.\\
  {\scriptsize\color{gray}
  \(s_i=c_i(s_{-i})+\rho_i\)}

  \item This {\bf extra payment} is an insurance premium, and it increases when electoral defeat is more likely for the party.\\
  {\scriptsize\color{gray}
  \(\rho_i^\ast=\rho(\lambda_i,\ell_i,R_i)\)}
\end{itemize}

\medskip
\onslide<3->{
\begin{block}{Core idea}
{\scriptsize Party initiative can raise voter payoffs because parties may pay above the minimum switching price.}
\end{block}
}
\end{column}

% RIGHT
\begin{column}{0.45\textwidth}
\centering
\begin{tikzpicture}[scale=0.9,baseline=(base.base)]
  \path[use as bounding box] (-0.2,-0.7) rectangle (5.2,3.5);
  \coordinate (base) at (2.5,0);

  % minimum compensation
  \onslide<1->{
    \draw[fill=gray!20] (0.7,0) rectangle (1.5,1.2);
    \node[below] at (1.1,0) {\scriptsize \(c_i\)};
    \node[above,align=center] at (1.1,1.2)
      {\scriptsize minimum\\[-1mm]\scriptsize compensation};
  }

  % insurance premium
  \onslide<2->{
    \draw[fill=orange!25] (2.2,0) rectangle (3.0,1.2);
    \draw[fill=orange!45] (2.2,1.2) rectangle (3.0,2.0);
    \node[below] at (2.6,0) {\scriptsize \(s_i\)};
    \node[right] at (3.05,1.6) {\scriptsize \(\rho_i\)};
    \node[above,align=center] at (2.6,2.0)
      {\scriptsize offer with\\[-1mm]\scriptsize insurance};
  }

  % cap
  \onslide<3->{
    \draw[dashed,thick] (3.6,2.4) -- (5.0,2.4);
    \node[right] at (5.0,2.4) {\scriptsize \(\overline{R}_i\)};
    \draw[<->,thick] (4.2,1.2) -- (4.2,2.4);
    \node[right,align=left] at (4.25,1.8)
      {\scriptsize extra\\[-1mm]\scriptsize payment};
  }
\end{tikzpicture}
\end{column}

\end{columns}
\end{frame}
\fi

\iffalse
\miniframesoff
\begin{frame}[c]{Vote Selling: Voters Move First}
\begin{columns}[T,totalwidth=\textwidth]

% LEFT
\begin{column}{0.55\textwidth}
\begin{itemize}[<+->]
  \item When voters move first, they send offers to each party, and each party accepts only if the price is below its willingness to pay.\\
  {\scriptsize\color{gray}
  Party \(i\) accepts when \(a_i\leq\overline{R}_i\).}

  \item Voters therefore try to extract the highest acceptable price, while still accounting for the ideological cost of supporting each party.\\
  {\scriptsize\color{gray}
  The voter compares \(u_j(\gamma_i)+\overline{R}_i\).}
\end{itemize}

\medskip
\onslide<3->{
\begin{block}{Core idea}
{\scriptsize For voters, this turns into a ``higher asking price.''}
\end{block}
}
\end{column}

