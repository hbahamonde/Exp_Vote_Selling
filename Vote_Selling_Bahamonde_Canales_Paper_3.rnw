\subsection*{A.2 Proposer advantage: robustness}

\begin{table}[H]
\centering
\caption{Proposer advantage by voter group and earnings measure}\label{tab:gaps}
\footnotesize
\resizebox{\textwidth}{!}{%
\begin{tabular}{llrrrrrr}
\toprule
Earnings & Voters & Estimate & 95\% CI & $p$ & MDE & Benchmark & $p$ (= benchmark) \\
\midrule
Rules of the game & Pivotal & \Sexpr{f0(Gr$est)} & [\Sexpr{f0(Gr$lo)}, \Sexpr{f0(Gr$hi)}] & \Sexpr{f2(Gr$p)} & \Sexpr{f0(Gr$mde)} & \Sexpr{f0(Gr$bench)} & \Sexpr{f2(Gr$p.bench)} \\
 & Non-pivotal & \Sexpr{f0(Gn$est)} & [\Sexpr{f0(Gn$lo)}, \Sexpr{f0(Gn$hi)}] & \Sexpr{f2(Gn$p)} & \Sexpr{f0(Gn$mde)} & \Sexpr{f0(Gn$bench)} & \Sexpr{f2(Gn$p.bench)} \\
 & All & \Sexpr{f0(Ga$est)} & [\Sexpr{f0(Ga$lo)}, \Sexpr{f0(Ga$hi)}] & \Sexpr{f2(Ga$p)} & \Sexpr{f0(Ga$mde)} & \Sexpr{f0(Ga$bench)} & \Sexpr{f2(Ga$p.bench)} \\
Recorded by software & Pivotal & \Sexpr{f0(Gd$est)} & [\Sexpr{f0(Gd$lo)}, \Sexpr{f0(Gd$hi)}] & \Sexpr{f2(Gd$p)} & \Sexpr{f0(Gd$mde)} & \Sexpr{f0(Gd$bench)} & \Sexpr{f2(Gd$p.bench)} \\
 & Non-pivotal & \Sexpr{f0(Gnd$est)} & [\Sexpr{f0(Gnd$lo)}, \Sexpr{f0(Gnd$hi)}] & \Sexpr{f2(Gnd$p)} & \Sexpr{f0(Gnd$mde)} & \Sexpr{f0(Gnd$bench)} & \Sexpr{f2(Gnd$p.bench)} \\
 & All & \Sexpr{f0(Gad$est)} & [\Sexpr{f0(Gad$lo)}, \Sexpr{f0(Gad$hi)}] & \Sexpr{f2(Gad$p)} & \Sexpr{f0(Gad$mde)} & \Sexpr{f0(Gad$bench)} & \Sexpr{f2(Gad$p.bench)} \\
\bottomrule
\end{tabular}}
\par\vspace{0.5em}\begin{minipage}{0.95\textwidth}\footnotesize \emph{Notes:} Difference in mean voter points per round, price-setting voter minus price-setting parties. Standard errors clustered by session ($t$ distribution with $G-2$ degrees of freedom). MDE: minimum detectable effect at 80\% power and 5\% significance. Benchmark: difference in mean equilibrium earnings (Propositions \ref{prop:buying}--\ref{prop:selling}) given each round's draws.\end{minipage}
\end{table}

\subsection*{A.3 Leading and trailing parties}

\begin{table}[H]
\centering
\caption{Offers and acceptances by the party's position before the voter acts}\label{tab:lead}
\small
<<lead_print, echo=FALSE, results='asis'>>=
lt <- as.data.frame(rt$lead.tab)
lt$Voter <- ifelse(lt$pivotal == 1, "Pivotal", "Non-pivotal")
lt$Party <- ifelse(lt$lead_party == 1, "Leading", "Trailing")
lt <- lt[order(lt$stat, -lt$pivotal, -lt$lead_party), c("stat", "Voter", "Party", "n", "value")]
lt$value <- round(lt$value, 1)
print(knitr::kable(lt, format = "latex", booktabs = TRUE, row.names = FALSE,
                   col.names = c("Statistic", "Voter", "Party", "N", "Mean")))
@
\par\vspace{0.5em}\begin{minipage}{0.9\textwidth}\footnotesize \emph{Notes:} A party leads if it has more votes than its rival before the voter acts. Tests of the leading--trailing difference (party-clustered) are reported in the text.\end{minipage}
\end{table}

